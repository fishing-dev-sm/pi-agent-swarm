{
  "name": "pi-agent-swarm-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the pi-agent-swarm Pi extension.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-agent-swarm/src/index.ts"
    ]
  },
  "scripts": {
    "dev": "npm install && npm run build && PI_TIMING=1 PI_CODING_AGENT_DIR=.pi/agent pi",
    "build": "npm --workspaces --if-present run build",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "node ./scripts/run-typechecks.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "check": "npm run build && node ./scripts/run-checks.mjs",
    "check:biome": "biome check .",
    "check:boundaries": "node ./scripts/check-extension-boundaries.mjs",
    "prepare": "node .husky/install.mjs",
    "benchmark:extension-startup": "node ./scripts/benchmark-extension-startup.mjs",
    "package:doctor": "node ./scripts/run-package-workflow.mjs doctor",
    "package:doctor-all": "node ./scripts/run-package-workflow.mjs doctor-all",
    "package:install": "node ./scripts/run-package-workflow.mjs install",
    "package:pack": "node ./scripts/run-package-workflow.mjs pack",
    "package:public": "node ./scripts/run-package-workflow.mjs public",
    "update": "node ./scripts/run-dependency-update.mjs all",
    "update:lock": "node ./scripts/run-dependency-update.mjs lock",
    "update:verify": "node ./scripts/run-dependency-update.mjs verify",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@earendil-works/pi-agent-core": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-server": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "npm-check-updates": "23.1.0",
    "semver": "7.8.5",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "node-domexception": "npm:@profoundlogic/node-domexception@1.0.2",
    "protobufjs": "7.6.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false
  }
}
